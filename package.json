{
  "name": "eu-ai-act-mcp",
  "version": "0.1.0",
  "description": "Deterministic provision tree, diff and measurements for the EU AI Act (Regulation (EU) 2024/1689)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altanziya/eu-ai-act-mcp.git"
  },
  "homepage": "https://altanziya.github.io/eu-ai-act-mcp/",
  "keywords": [
    "eu-ai-act",
    "mcp",
    "model-context-protocol",
    "legal-tech",
    "citation-verification"
  ],
  "type": "module",
  "bin": {
    "eu-ai-act-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "data/corpus",
    "data/diff/de.json",
    "data/diff/en.json",
    "data/deadlines.json",
    "data/obligations.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/build-server.ts",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "fetch": "tsx scripts/fetch-raw.ts",
    "parse": "tsx scripts/parse.ts",
    "h3": "tsx scripts/h3.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "release": "tsx scripts/release.ts",
    "sign": "tsx scripts/sign.ts",
    "record": "tsx scripts/record.ts",
    "build:site": "tsx scripts/build-site.ts",
    "site:serve": "tsx scripts/site-serve.ts",
    "cost:probe": "tsx scripts/cost-probe.ts",
    "eval": "tsx src/eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "htmlparser2": "^12.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
